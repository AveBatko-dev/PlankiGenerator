{
  "code": "pl_35",
  "display_code": "Пл. 35",
  "name": "Планка з верхньою горизонтальною ділянкою, правою вертикальною стінкою та двома похилими завальцовками",

  "defaults": {
    "profile_width": 3,
    "dimension_offset": 22,
    "text_height": 8
  },

  "profile": {
    "type": "connected_path",
    "elements": [
      {
        "type": "line",
        "name": "upper_left_slanted",
        "start": [
          "D*cos(radians(K2))",
          "D*sin(radians(K2))"
        ],
        "end": [
          0,
          0
        ]
      },
      {
        "type": "line",
        "name": "top_horizontal",
        "start": [
          0,
          0
        ],
        "end": [
          "C",
          0
        ]
      },
      {
        "type": "line",
        "name": "right_vertical",
        "start": [
          "C",
          0
        ],
        "end": [
          "C",
          "-B"
        ]
      },
      {
        "type": "line",
        "name": "bottom_slanted",
        "start": [
          "C",
          "-B"
        ],
        "end": [
          "C + A*cos(radians(90 + K1))",
          "-B + A*sin(radians(90 + K1))"
        ]
      }
    ]
  },

  "hooks": [
