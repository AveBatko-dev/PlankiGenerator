      "name": "bottom_hook_z1",
      "attach_to": "bottom_slanted",
      "position": "end",
      "length": 18,
      "angle": 90,
      "bend_side": "inner",
      "label": "Z1",
      "label_height": 8,
      "label_fixed_direction": "opposite_dimension",
      "label_dimension_fallback": "opposite_hook_side",
      "label_placement_mode": "strict",
      "label_fixed_gap": 8
    }
  ],

  "dimensions": [
    {
      "type": "parallel_to_line",
      "name": "dimension_D",
      "param": "D",
      "target": "upper_left_slanted",
      "offset": 24,
      "side": "right",
