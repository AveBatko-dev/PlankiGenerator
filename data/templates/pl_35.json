    {
      "type": "parallel_to_line",
      "name": "dimension_B",
      "param": "B",
      "target": "right_vertical",
      "offset": 28,
      "side": "left",
      "text_rotation": 90,
      "text_side": "outside",
      "text_gap": 5,
      "extension_overhang": 6
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_A",
      "param": "A",
      "target": "bottom_slanted",
      "offset": 24,
      "side": "left",
      "text_rotation": "auto",
