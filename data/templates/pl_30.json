{
  "code": "pl_30",
  "display_code": "Пл. 30",
  "name": "Планка з лівим похилим відводом, верхньою похилою лінією та правою завальцовкою",

  "defaults": {
    "profile_width": 3,
    "dimension_offset": 22,
    "text_height": 8
  },

  "profile": {
    "type": "connected_path",
    "elements": [
      {
        "type": "line",
        "name": "left_slanted",
        "start": [
          "-A*sin(radians(K1))",
          "-A*cos(radians(K1))"
        ],
        "end": [
          0,
          0
        ]
      },
      {
        "type": "line",
        "name": "left_vertical",
        "start": [
          0,
          0
        ],
        "end": [
          0,
          "B"
        ]
      },
      {
        "type": "line",
        "name": "top_slanted",
        "start": [
          0,
          "B"
        ],
        "end": [
          "C*sin(radians(K2))",
          "B + C*cos(radians(K2))"
        ]
      },
      {
        "type": "line",
        "name": "right_vertical",
        "start": [
          "C*sin(radians(K2))",
          "B + C*cos(radians(K2))"
        ],
        "end": [
          "C*sin(radians(K2))",
          "B + C*cos(radians(K2)) - D"
        ]
      }
    ]
  },

  "hooks": [
    {
      "type": "hook",
      "name": "left_hook_z1",
      "attach_to": "left_slanted",
      "position": "start",
      "length": 18,
      "angle": 90,
      "bend_side": "inner",
      "label": "Z1",
      "label_height": 8,
      "label_fixed_side": "left"
    },
    {
      "type": "hook",
      "name": "right_hook_z2",
      "attach_to": "right_vertical",
      "position": "end",
      "length": 18,
      "angle": 90,
      "bend_side": "inner",
      "label": "Z2",
      "label_height": 8,
      "label_fixed_side": "left"
    }
  ],

  "dimensions": [
    {
      "type": "parallel_to_line",
      "name": "dimension_A",
      "param": "A",
      "target": "left_slanted",
      "offset": 24,
      "side": "right",
      "text_rotation": "auto",
      "text_side": "outside",
      "text_gap": 5,
      "hook_line_clearance": -1,
      "extension_overhang": 6
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_B",
      "param": "B",
      "target": "left_vertical",
      "offset": 22,
      "side": "left",
      "text_rotation": 90,
      "text_side": "outside",
      "text_gap": 5
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_C",
      "param": "C",
      "target": "top_slanted",
      "offset": 24,
      "side": "left",
      "text_rotation": "auto",
      "text_side": "outside",
      "text_gap": 5,
      "extension_overhang": 6
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_D",
      "param": "D",
      "target": "right_vertical",
      "offset": 28,
      "side": "left",
      "text_rotation": 90,
      "text_side": "outside",
      "text_gap": 5,
      "hook_line_clearance": -1,
      "extension_overhang": 6
    }
  ],

  "markers": [
    {
      "type": "thickness_triangle",
      "name": "thickness_marker",
      "target": "left_vertical",
      "auto_place": true,
      "height": 12,
      "depth": 10,
      "offset": 0.5
    }
  ],

  "angle_marks": [
    {
      "type": "between_lines",
      "name": "angle_K1",
      "param": "K1",

      "line_1": "left_vertical",
      "line_2": "left_slanted",

      "center_point": "start",
      "line_2_point": "start",

      "radius": 28,
      "tick_size": 12,
      "text_offset": 7,

      "text_rotation": "auto",

      "enabled": true
    },
    {
      "type": "between_lines",
      "name": "angle_K2",
      "param": "K2",

      "line_1": "right_vertical",
      "line_2": "top_slanted",

      "center_point": "start",
      "line_2_point": "start",

      "radius": 28,
      "tick_size": 12,
      "text_offset": 7,

      "arc_side": "other",
      "text_rotation": "auto",

      "enabled": true
    }
  ]
}
