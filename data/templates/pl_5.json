{
  "code": "pl_5",
  "display_code": "Пл. 5",
  "name": "Кутник зовнішній",
  "defaults": {
    "profile_width": 3,
    "dimension_offset": 22,
    "text_height": 8
  },
  "profile": {
    "type": "connected_path",
    "elements": [
      {"type": "line", "name": "vertical_main", "start": [0, 0], "end": [0, "B"]},
      {
        "type": "line",
        "name": "angled_main",
        "start": [0, "B"],
        "end": [
          "A*cos(radians(K1-90))",
          "B + A*sin(radians(K1-90))"
        ]
      }
    ]
  },
  "hooks": [
    {"type": "hook", "name": "bottom_hook", "attach_to": "vertical_main", "position": "start", "length": 18, "angle": 90},
    {"type": "hook", "name": "right_hook", "attach_to": "angled_main", "position": "end", "length": 18, "angle": 90}
  ],
  "dimensions": [
    {"type": "parallel_to_line", "name": "dimension_B", "param": "B", "target": "vertical_main",
      "offset": 22, "side": "left", "text_rotation": 90},
    {"type": "parallel_to_line", "name": "dimension_A", "param": "A", "target": "angled_main",
      "offset": 22, "side": "left", "text_rotation": "auto"}
  ],
  "markers": [
    {"type": "thickness_triangle", "name": "thickness_marker", "target": "vertical_main",
      "position": 0.5, "side": "left", "height": 12, "depth": 10, "offset": 0.5}
  ],
  "angle_marks": [
    {"type": "between_lines", "name": "angle_K1", "param": "K1", "line_1": "vertical_main",
      "line_2": "angled_main", "radius": 28, "text_offset": 8, "enabled": true}
  ]
}
