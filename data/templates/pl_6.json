{
  "code": "pl_6",
  "display_code": "Пл. 6",
  "name": "Кутник зовнішній рівнополичний з зовнішніми завальцовками",
  "defaults": {
    "profile_width": 3,
    "dimension_offset": 22,
    "text_height": 8
  },
  "profile": {
    "type": "connected_path",
    "elements": [
      {"type": "line", "name": "vertical_main", "start": [0, 0], "end": [0, "A"]},
      {
        "type": "line",
        "name": "top_main",
        "start": [0, "A"],
        "end": [
          "A*cos(radians(K1-90))",
          "A + A*sin(radians(K1-90))"
        ]
      }
    ]
  },
  "hooks": [
    {"type": "hook", "name": "bottom_hook_z1", "attach_to": "vertical_main", "position": "start",
      "length": 18, "angle": 90, "side": "left", "label": "Z1", "label_anchor": "base", "label_min_clearance": 8, "label_height": 8},
    {"type": "hook", "name": "right_hook_z2", "attach_to": "top_main", "position": "end",
      "length": 18, "angle": 90, "side": "left", "label": "Z2", "label_anchor": "base", "label_min_clearance": 8, "label_height": 8}
  ],
  "dimensions": [
    {"type": "parallel_to_line", "name": "dimension_A_vertical", "param": "A", "target": "vertical_main",
      "offset": 22, "side": "left", "text_rotation": 90},
    {"type": "parallel_to_line", "name": "dimension_A_top", "param": "A", "target": "top_main",
      "offset": 22, "side": "left", "text_rotation": "auto"}
  ],
  "angle_marks": [
    {"type": "between_lines", "name": "angle_K1", "param": "K1", "line_1": "vertical_main",
      "line_2": "top_main", "radius": 28, "text_offset": 8, "enabled": true}
  ]
}
