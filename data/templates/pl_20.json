{
  "code": "pl_20",
  "display_code": "Пл. 20",
  "name": "Планка дахоподібна з двома завальцовками",

  "defaults": {
    "profile_width": 3,
    "dimension_offset": 22,
    "text_height": 8
  },

  "profile": {
    "type": "connected_path",
    "elements": [
      {
        "type": "line",
        "name": "left_bottom_horizontal",
        "start": ["-A", 0],
        "end": [0, 0]
      },
      {
        "type": "line",
        "name": "left_vertical",
        "start": [0, 0],
        "end": [0, "B"]
      },
      {
        "type": "line",
        "name": "left_slanted",
        "start": [0, "B"],
        "end": [
          "C*sin(radians(K1/2))",
          "B + C*cos(radians(K1/2))"
        ]
      },
      {
        "type": "line",
        "name": "right_slanted",
        "start": [
          "C*sin(radians(K1/2))",
          "B + C*cos(radians(K1/2))"
        ],
        "end": [
          "2*C*sin(radians(K1/2))",
          "B"
        ]
      },
      {
        "type": "line",
        "name": "right_vertical",
        "start": [
          "2*C*sin(radians(K1/2))",
          "B"
        ],
        "end": [
          "2*C*sin(radians(K1/2))",
          0
        ]
      },
      {
        "type": "line",
        "name": "right_bottom_horizontal",
        "start": [
          "2*C*sin(radians(K1/2))",
          0
        ],
        "end": [
          "2*C*sin(radians(K1/2)) + A",
          0
        ]
      }
    ]
  },

  "hooks": [
    {
      "type": "hook",
      "name": "left_hook_z1",
      "attach_to": "left_bottom_horizontal",
      "position": "start",
      "length": 18,
      "angle": 90,
      "bend_side": "inner",
      "label": "Z1",
      "label_height": 8,
      "label_fixed_side": "left"
    },
    {
      "type": "hook",
      "name": "right_hook_z2",
      "attach_to": "right_bottom_horizontal",
      "position": "end",
      "length": 18,
      "angle": 90,
      "bend_side": "inner",
      "label": "Z2",
      "label_height": 8,
      "label_fixed_side": "right"
    }
  ],

  "dimensions": [
    {
      "type": "parallel_to_line",
      "name": "dimension_A_left",
      "param": "A",
      "target": "left_bottom_horizontal",
      "offset": 22,
      "side": "right",
      "text_rotation": "auto",
      "hook_line_clearance": -1,
      "extension_overhang": 6
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_A_right",
      "param": "A",
      "target": "right_bottom_horizontal",
      "offset": 22,
      "side": "right",
      "text_rotation": "auto",
      "hook_line_clearance": -1,
      "extension_overhang": 6
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_B_left",
      "param": "B",
      "target": "left_vertical",
      "offset": 18,
      "side": "left",
      "text_rotation": 90,
      "text_gap": 5
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_B_right",
      "param": "B",
      "target": "right_vertical",
      "offset": 18,
      "side": "left",
      "text_rotation": 90,
      "text_gap": 5
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_C_left",
      "param": "C",
      "target": "left_slanted",
      "offset": 22,
      "side": "left",
      "text_rotation": "auto",
      "text_side": "outside",
      "text_gap": 5
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_C_right",
      "param": "C",
      "target": "right_slanted",
      "offset": 22,
      "side": "left",
      "text_rotation": "auto",
      "text_side": "outside",
      "text_gap": 5
    }
  ],

  "markers": [
    {
      "type": "thickness_triangle",
      "name": "thickness_marker",
      "target": "left_slanted",
      "position": 0.42,
      "side": "left",
      "height": 12,
      "depth": 10,
      "offset": 0.5
    }
  ],

  "angle_marks": [
    {
      "type": "between_lines",
      "name": "angle_K1",
      "param": "K1",

      "line_1": "left_slanted",
      "line_2": "right_slanted",

      "radius": 32,
      "tick_size": 12,
      "text_offset": 7,

      "text_rotation": "auto",

      "enabled": true
    }
  ]
}
