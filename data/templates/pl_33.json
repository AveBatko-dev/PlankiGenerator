{
  "code": "pl_33",
  "display_code": "Пл. 33",
  "name": "Планка з похилим відводом, похилою верхньою полицею та завальцовкою Z1",

  "defaults": {
    "profile_width": 3,
    "dimension_offset": 22,
    "text_height": 8
  },

  "profile": {
    "type": "connected_path",
    "elements": [
      {
        "type": "line",
        "name": "left_slanted",
        "start": [
          "A*cos(radians(12-K1))",
          "A*sin(radians(12-K1))"
        ],
        "end": [
          0,
          0
        ]
      },
      {
        "type": "line",
        "name": "top_slanted",
        "start": [
          0,
          0
        ],
        "end": [
          "B*cos(radians(12))",
          "B*sin(radians(12))"
        ]
      }
    ]
  },

  "hooks": [
    {
      "type": "hook",
      "name": "left_hook_z1",
      "attach_to": "left_slanted",
      "position": "start",
      "length": 18,
      "angle": 90,
      "bend_side": "inner",
      "label": "Z1",
      "label_height": 8,
      "label_fixed_direction": "opposite_dimension",
      "label_dimension_fallback": "opposite_hook_side",
      "label_placement_mode": "strict",
      "label_fixed_gap": 8
    }
  ],

  "dimensions": [
    {
      "type": "parallel_to_line",
      "name": "dimension_A",
      "param": "A",
      "target": "left_slanted",
      "offset": 24,
      "side": "left",
      "text_rotation": "auto",
      "text_side": "outside",
      "text_gap": 5,
      "hook_line_clearance": -1,
      "extension_overhang": 6
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_B",
      "param": "B",
      "target": "top_slanted",
      "offset": 24,
      "side": "left",
      "text_rotation": "auto",
      "text_side": "outside",
      "text_gap": 5,
      "extension_overhang": 6
    }
  ],

  "markers": [
    {
      "type": "thickness_triangle",
      "name": "thickness_marker",
      "target": "top_slanted",
      "auto_place": false,
      "position": 0.65,
      "side": "right",
      "height": 12,
      "depth": 10,
      "offset": 0.5
    }
  ],

  "angle_marks": [
    {
      "type": "between_lines",
      "name": "angle_K1",
      "param": "K1",

      "line_1": "top_slanted",
      "line_2": "left_slanted",

      "center_point": "start",
      "line_2_point": "start",

      "radius": 28,
      "tick_size": 12,
      "text_offset": 7,

      "arc_side": "other",
      "text_rotation": "auto",

      "enabled": true
    }
  ]
}
