{
  "code": "pl_36",
  "display_code": "Пл. 36",
  "name": "Трапецієподібна планка з рівними боковими сторонами",

  "defaults": {
    "profile_width": 3,
    "dimension_offset": 22,
    "text_height": 8
  },

  "profile": {
    "type": "connected_path",
    "elements": [
      {
        "type": "line",
        "name": "left_slanted",
        "start": [0, 0],
        "end": [
          "(A - B) / 2",
          "((A - B) / 2) * tan(radians(K1))"
        ]
      },
      {
        "type": "line",
        "name": "top_horizontal",
        "start": [
          "(A - B) / 2",
          "((A - B) / 2) * tan(radians(K1))"
        ],
        "end": [
          "(A + B) / 2",
          "((A - B) / 2) * tan(radians(K1))"
        ]
      },
      {
        "type": "line",
        "name": "right_slanted",
        "start": [
          "(A + B) / 2",
          "((A - B) / 2) * tan(radians(K1))"
        ],
        "end": [
          "A",
          0
        ]
      },
      {
        "type": "line",
        "name": "bottom_horizontal",
        "start": [
          "A",
          0
        ],
        "end": [
          0,
          0
        ]
      }
    ]
  },

  "hooks": [],

  "dimensions": [
    {
      "type": "parallel_to_line",
      "name": "dimension_A",
