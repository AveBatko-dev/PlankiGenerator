      "offset": 22,
      "side": "left",
      "text_rotation": "auto",
      "text_side": "outside",
      "text_gap": 5,
      "extension_overhang": 6
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_C",
      "param": "C",
      "target": "left_slanted",
      "offset": 24,
      "side": "left",
      "text_rotation": "auto",
      "text_side": "outside",
      "text_gap": 5,
      "extension_overhang": 6
    }
  ],

  "markers": [],

  "angle_marks": [
    {
      "type": "between_lines",
      "name": "angle_K1",
      "param": "K1",

      "line_1": "bottom_horizontal",
      "line_2": "right_slanted",

      "center_point": "start",
      "line_2_point": "start",

