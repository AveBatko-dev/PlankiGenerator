{
  "code": "pl_17",
  "display_code": "Пл. 17",
  "name": "Планка Г-подібна з нижньою завальцовкою",

  "defaults": {
    "profile_width": 3,
    "dimension_offset": 22,
    "text_height": 8
  },

  "profile": {
    "type": "connected_path",
    "elements": [
      {
        "type": "line",
        "name": "vertical_main",
        "start": [0, 0],
        "end": [0, "A"]
      },
      {
        "type": "line",
        "name": "top_horizontal",
        "start": [0, "A"],
        "end": ["B", "A"]
      }
    ]
  },

  "hooks": [
    {
      "type": "hook",
      "name": "bottom_hook_z1",
      "attach_to": "vertical_main",
      "position": "start",
      "length": 18,
      "angle": 90,
      "bend_side": "inner",
      "label": "Z1",
      "label_height": 8,
      "label_fixed_side": "right"
    }
  ],

  "dimensions": [
    {
      "type": "parallel_to_line",
      "name": "dimension_A",
      "param": "A",
      "target": "vertical_main",
      "offset": 22,
      "side": "left",
      "text_rotation": 90,
      "hook_line_clearance": -1,
      "extension_overhang": 6
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_B",
      "param": "B",
      "target": "top_horizontal",
      "offset": 22,
      "side": "left",
      "text_rotation": "auto"
    }
  ],

  "markers": [
    {
      "type": "thickness_triangle",
      "name": "thickness_marker",
      "target": "vertical_main",
      "position": 0.52,
      "side": "right",
      "height": 12,
      "depth": 10,
      "offset": 0.5
    }
  ],

  "angle_marks": [
    {
      "type": "between_lines",
      "name": "angle_K1",
      "param": "K1",

      "line_1": "vertical_main",
      "line_2": "top_horizontal",

      "radius": 32,
      "tick_size": 12,
      "text_offset": 7,

      "text_rotation": "auto",

      "enabled": true
    }
  ]
}
