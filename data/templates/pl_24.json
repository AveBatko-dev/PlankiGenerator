{
  "code": "pl_24",
  "display_code": "Пл. 24",
  "name": "Планка П-образная односторонняя с завальцовкой",

  "defaults": {
    "profile_width": 3,
    "dimension_offset": 22,
    "text_height": 8
  },

  "profile": {
    "type": "connected_path",
    "elements": [
      {
        "type": "line",
        "name": "bottom_horizontal",
        "start": ["A", 0],
        "end": [0, 0]
      },
      {
        "type": "line",
        "name": "left_vertical",
        "start": [0, 0],
        "end": [0, "B"]
      },
      {
        "type": "line",
        "name": "top_horizontal",
        "start": [0, "B"],
        "end": ["C", "B"]
      }
    ]
  },

  "hooks": [
    {
      "type": "hook",
      "name": "right_hook_z1",
      "attach_to": "bottom_horizontal",
      "position": "start",
      "length": 18,
      "angle": 90,
      "bend_side": "inner",
      "label": "Z1",
      "label_height": 8,
      "label_fixed_side": "right"
    }
  ],

  "dimensions": [
    {
      "type": "parallel_to_line",
      "name": "dimension_A",
      "param": "A",
      "target": "bottom_horizontal",
      "offset": 22,
      "side": "left",
      "text_rotation": "auto",
      "hook_line_clearance": -1,
      "extension_overhang": 6
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_B",
      "param": "B",
      "target": "left_vertical",
      "offset": 22,
      "side": "left",
      "text_rotation": 90,
      "text_gap": 5
    },
    {
      "type": "parallel_to_line",
      "name": "dimension_C",
      "param": "C",
      "target": "top_horizontal",
      "offset": 22,
      "side": "left",
      "text_rotation": "auto",
      "text_gap": 5
    }
  ],

  "markers": [
    {
      "type": "thickness_triangle",
      "name": "thickness_marker",
      "target": "left_vertical",
      "position": 0.5,
      "side": "left",
      "height": 12,
      "depth": 10,
      "offset": 0.5
    }
  ],

  "angle_marks": [
    {
      "type": "between_lines",
      "name": "angle_K1",
      "param": "K1",
      "line_1": "bottom_horizontal",
      "line_2": "left_vertical",
      "center_point": "end",
      "line_2_point": "end",
      "radius": 28,
      "tick_size": 12,
      "text_offset": 8,
      "text_rotation": "horizontal",
      "enabled": true
    }
  ]
}
